# ==============================================================================
# Cloudflare & ERPNext Deployment Environment Variables
# ==============================================================================

# 1. Cloudflare Tunnel Token (Obtained from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# 2. MariaDB Root Password
MYSQL_ROOT_PASSWORD=your_secure_mariadb_password

# 3. ERPNext Site & Admin Credentials
FRAPPE_SITE_NAME_HEADER=erp.yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

# 4. Optional Cloudflare Pages API Keys (For GitHub Actions deployment)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
